  {
    "name": "calendar-sync",
    "schedule": "0 12 * * *",
    "channel_id": 123456789012345678,
    "prompt": "Sync the in-game WoW event calendar with this Discord server's scheduled events calendar. Use wow_events to get the in-game calendar for the next 30 days and discord_events_list to see what's already scheduled, then create the missing events with discord_events_create and delete any Discord events that no longer appear in-game. Reply with a summary of changes."
  }
