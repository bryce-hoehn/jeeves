[
  {
    "name": "changelog-sweep",
    "schedule": "0 9 * * 1",
    "timezone": "America/New_York",
    "channel_id": 123456789012345678,
    "prompt": "Check the latest World of Warcraft update changelogs and hotfixes (news feeds are available via tools). Update the knowledgebase files in knowledge/ with anything that changed — patch notes, class tuning, system changes. Reply with a summary of what you added or changed, and note if there was nothing new."
